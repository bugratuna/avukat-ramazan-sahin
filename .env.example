# Postgres connection string (docker-compose'daki payload/payload/avukat_ramazan_sahin ile eşleşir)
# Üretimde (Vercel + Neon) buraya Neon panelinden alınan "Pooled connection" string'i gelir.
DATABASE_URL=postgresql://payload:payload@127.0.0.1:5432/avukat_ramazan_sahin

# JWT token şifreleme anahtarı — üretimde rastgele, uzun bir değerle değiştirin
PAYLOAD_SECRET=YOUR_SECRET_HERE

# CORS, link formatlama vb. için kullanılır. Sonunda / olmasın
# Üretimde gerçek domain: https://www.avukatramazansahin.com.tr
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cron job'ları doğrulamak için kullanılan secret
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Live preview isteklerini doğrulamak için kullanılır
PREVIEW_SECRET=YOUR_SECRET_HERE

# --- Üretim medya depolaması (Vercel Blob) ----------------------------
# Vercel projesine bir Blob Store bağlandığında bu değişken otomatik
# olarak enjekte edilir — elle girmeniz gerekmez. Yerel geliştirmede
# boş bırakın (yerel diske yükler).
BLOB_READ_WRITE_TOKEN=

# --- Üretim e-posta gönderimi (Resend) --------------------------------
# Tanımlıysa şifre sıfırlama ve form bildirimleri Resend üzerinden gider;
# tanımlı değilse (yerel geliştirme) e-postalar konsola yazılır.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=info@avukatramazansahin.com.tr
