# Postgres connection string (docker-compose'daki payload/payload/avukat_ramazan_sahin ile eşleşir)
DATABASE_URL=postgresql://payload:payload@127.0.0.1:5432/avukat_ramazan_sahin

# JWT token şifreleme anahtarı — üretimde rastgele, uzun bir değerle değiştirin
PAYLOAD_SECRET=YOUR_SECRET_HERE

# CORS, link formatlama vb. için kullanılır. Sonunda / olmasın
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cron job'ları doğrulamak için kullanılan secret
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Live preview isteklerini doğrulamak için kullanılır
PREVIEW_SECRET=YOUR_SECRET_HERE
